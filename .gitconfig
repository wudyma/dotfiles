[user]
  name = Zheng Ma
  email = zhengma@sjtu.edu.cn
  signingKey = ~/.ssh/id_ed25519.pub
[gpg]
  format = ssh
[commit]
  gpgSign = true
  # Show the staged diff in the commit-message editor.
  verbose = true
[ghq]
  root = ~/repos
[init]
  defaultBranch = main
[fetch]
  prune = true
  # Speed up history traversal after fetching new objects.
  writeCommitGraph = true
[pull]
  # Resolve diverged history explicitly with merge or rebase.
  ff = only
[push]
  default = simple
  autoSetupRemote = true
[merge]
  conflictStyle = zdiff3
[rerere]
  # Reuse recorded conflict resolutions; review and stage them yourself.
  enabled = true
  autoUpdate = false
[rebase]
  autoSquash = true
  # Use "drop" to remove a commit intentionally from the rebase todo list.
  missingCommitsCheck = error
[diff]
  algorithm = histogram
  renames = true
  colorMoved = zebra
  submodule = log
[status]
  submoduleSummary = 5
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[grep]
  lineNumber = true
[help]
  # Ask before executing a suggested correction for a mistyped command.
  autoCorrect = prompt
[core]
  quotePath = false
[color]
  ui = auto

[alias]
  a = add -p
  d = diff
  ds = diff --staged
  co = checkout
  sw = switch
  ci = commit
  ca = commit -a
  fixup = commit --fixup
  ri = rebase --interactive
  ps = push
  pl = pull
  st = status
  br = branch
  ba = branch -a
  bm = branch --merged
  bn = branch --no-merged
  df = show
  hist = log --graph --date=relative --decorate --all --format='%Cgreen%h%Creset %cd %Cblue[%cn]%Creset %s%C(yellow)%d%Creset'
  llog = log --graph --name-status --date=relative --format='%C(red)%h%Creset (%cd) %C(green)%an%Creset %s %C(yellow)%d%Creset'
  find = log -p -S
  type = cat-file -t
  dump = cat-file -p
  unmerged = diff --name-only --diff-filter=U
  add-unmerged = "!git diff --name-only --diff-filter=U -z | git --literal-pathspecs add --pathspec-from-file=- --pathspec-file-nul"
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process
# Optional machine-specific overrides; keep this include last.
[include]
  path = ~/.gitconfig.local
