  "format_on_save": "on",
  "soft_wrap": "editor_width",
  // Typography
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 16,
  "buffer_line_height": {
    "custom": 1.8,
  },
  "buffer_font_features": {
    "calt": true,
  },
