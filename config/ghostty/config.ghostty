theme = Ultra Dark

font-family = Maple Mono NF CN
font-size = 18

background-opacity = 0.8
background-blur = macos-glass-regular

cursor-style = block
cursor-style-blink = true

macos-option-as-alt = true

window-padding-x = 8
window-padding-y = 8

shell-integration-features = ssh-env,ssh-terminfo
